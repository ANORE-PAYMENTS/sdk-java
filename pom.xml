<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cc.anore</groupId>
  <artifactId>anore</artifactId>
  <version>1.3.0</version>
  <packaging>jar</packaging>

  <name>ANORE Java SDK</name>
  <description>Official ANORE payments SDK for Java — payments, subscriptions and payouts. Zero runtime dependencies, JDK 11+.</description>
  <url>https://github.com/ANORE-PAYMENTS/sdk-java</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/ANORE-PAYMENTS/sdk-java</url>
    <connection>scm:git:https://github.com/ANORE-PAYMENTS/sdk-java.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/ANORE-PAYMENTS/sdk-java.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <developers>
    <developer>
      <name>ANORE Payments</name>
      <url>https://anore.cc</url>
    </developer>
  </developers>

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- zero runtime dependencies: JDK 11+ only (java.net.http, javax.crypto) -->

</project>
